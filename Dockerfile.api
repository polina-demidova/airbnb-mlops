FROM python:3.9-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    pandas==2.3.3 \
    numpy==2.0.2 \
    scikit-learn==1.6.1 \
    fastapi==0.115.12 \
    uvicorn==0.34.2 \
    pydantic==2.11.4

COPY api.py /app/api.py

EXPOSE 8000

CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000"]