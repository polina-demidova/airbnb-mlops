FROM python:3.9-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

RUN pip install --no-cache-dir \
    boto3 \
    pandas==2.3.3 \
    numpy==2.0.2 \
    scikit-learn==1.6.1 \
    python-dotenv

COPY train.py /app/train.py

RUN mkdir -p /models

ENV MODEL_PATH=/models/model.pkl

CMD ["python", "train.py"]